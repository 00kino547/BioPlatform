# ===========================================
# Bio Platform - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# -------------------------------------------
# Application
# -------------------------------------------
NODE_ENV=production
APP_NAME=BioPlatform
APP_TAGLINE=Your digital identity, beautifully crafted.
APP_DESCRIPTION=Create a stunning profile page that showcases who you are. Links, music, themes, and more — all in one place.
APP_URL=http://localhost:80
APP_URL_HOST=localhost
APP_GITHUB_URL=https://github.com/00kino547/BioPlatform

# -------------------------------------------
# Cache
# -------------------------------------------
# Cache driver: memory | redis | file | db
# Default is "redis" (the bundled Valkey-compatible Redis service in docker-compose).
# - memory: in-process Map (single instance only, lost on restart)
# - redis:  shared cache, recommended for multi-instance / production (uses CACHE_REDIS_URL,
#           wire-compatible with Redis, Valkey, KeyDB, Dragonfly, etc.)
# - file:   JSON files on disk (CACHE_FILE_DIR, default ./data/cache)
# - db:     PostgreSQL cache_entries table (slowest, keeps restarts warm)
CACHE_DRIVER=redis
# Redis connection URL. Inside the Docker network this is redis://redis:6379.
CACHE_REDIS_URL=redis://localhost:6379
# Directory used by the "file" driver (Docker default /app/data/cache).
CACHE_FILE_DIR=./data/cache

# Update check: version badge in the footer + critical/security lockdown
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_MINUTES=720
UPDATE_CHECK_STALE_MAX_MINUTES=1440
UPDATE_CRITICAL_STALE_THRESHOLD=3
# Include pre-release versions in the update check. Default false: pre-releases are excluded
# from updates/severity/lockdown everywhere (they only surface as a minimal notification to admins
# in the admin panel). When true, pre-releases count as normal updates and can raise severity to
# "security" (never "critical"), which locks security-sensitive settings until updated.
UPDATE_CHECK_INCLUDE_PRERELEASES=false

# -------------------------------------------
# Frontend
# -------------------------------------------
VITE_API_URL=/api
VITE_APP_NAME=BioPlatform
VITE_APP_TAGLINE=Your digital identity, beautifully crafted.
VITE_APP_DESCRIPTION=Create a stunning profile page that showcases who you are. Links, music, themes, and more — all in one place.
VITE_APP_URL=http://localhost:80
VITE_APP_GITHUB_URL=https://github.com/00kino547/BioPlatform
VITE_APP_OG_IMAGE=http://localhost:80/og.png
VITE_CONTACT_URL=https://github.com/00kino547/BioPlatform/issues
VITE_STATUS_URL=
VITE_DOCS_URL=https://github.com/00kino547/BioPlatform/tree/main/docs

# -------------------------------------------
# Backend
# -------------------------------------------
PORT=3000

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=bioplatform
DATABASE_URL=postgresql://postgres:replace-with-a-random-database-password@localhost:5432/bioplatform?schema=public

# -------------------------------------------
# CORS
# -------------------------------------------
CORS_ORIGIN=http://localhost:80

# -------------------------------------------
# Nginx
# -------------------------------------------
ENABLE_INTERNAL_NGINX=true
# Host ports the internal nginx is published on. Use any free ports, e.g.
# 80/443, 8080/8443, 3000/3443 — like mailcow. NOTE: if you change them you
# must mirror the port in APP_URL / VITE_APP_URL / CORS_ORIGIN /
# WEBAUTHN_ORIGIN (origins are scheme+host+port).
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# -------------------------------------------
# Host ports, network and paths (two instances)
# -------------------------------------------
# Defaults match a single instance. For a SECOND instance on the same host give
# every value below a different value (and a different COMPOSE_PROJECT_NAME):
#   POSTGRES_HOST_PORT=15432
#   REDIS_HOST_PORT=16379
#   BACKEND_HOST_PORT=13001
#   NGINX_PORT=18081  NGINX_HTTPS_PORT=18444
#   NETWORK_NAME=bioplatform_b_net
#   CERTS_DIR=./certs-b  NGINX_CONFIG_DIR=./nginx-b
# Container ports stay 5432/6379/3000, so DATABASE_URL and CACHE_REDIS_URL do not
# change. NETWORK_NAME MUST differ: two stacks on one network make `postgres`
# resolve to the other instance's database.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=3000
NETWORK_NAME=bioplatform_net
CERTS_DIR=./certs
NGINX_CONFIG_DIR=./nginx
# TLS_MODE=development auto-generates self-signed certs (self-signed.pem/key.pem) into ./certs on startup.
# TLS_MODE=production deletes those and requires your cert.pem + key.pem in ./certs/ for real TLS.
TLS_MODE=development
SEND_HSTS_ON_DEV=false
CF_TRUSTED_IPS=172.16.0.0/12,127.0.0.1,::1

# -------------------------------------------
# Storage
# -------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
# Scheduled cleanup of orphaned uploads (files no longer referenced by any profile/theme/track).
ORPHAN_CLEANUP_ENABLED=true
# Interval between scans (minutes), minimum age before a file is considered orphaned (hours),
# and max age of regenerable .media-cache thumbnails (hours).
ORPHAN_CLEANUP_INTERVAL_MINUTES=360
ORPHAN_CLEANUP_GRACE_HOURS=24
MEDIA_CACHE_MAX_AGE_HOURS=168
# S3-compatible object storage (R2, AWS S3, MinIO, Wasabi, DigitalOcean Spaces, Backblaze S3-compatible, etc.).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false
# Native Backblaze B2 (STORAGE_PROVIDER=b2) — uses the B2 application key ID + key directly.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_PREFIX=
# Base API URL for the native B2 API (override only for testing/staging).
B2_API_URL=https://api.backblazeb2.com
# Compress uploads at rest in cloud buckets (local disk stays uncompressed).
STORAGE_COMPRESS_ENABLED=true
# Max number of files and total size of the local .media-cache disk used by
# cloud-backed uploads. Reduce to lower disk usage; increase if you serve many
# resized images.
MEDIA_CACHE_MAX_ENTRIES=2000
MEDIA_CACHE_MAX_SIZE_MB=512

# External background-image proxy: lets profiles use arbitrary https image URLs as
# custom backgrounds WITHOUT loosening the CSP img-src allowlist. The backend fetches
# the URL server-side (SSRF-safe: https-only, private/loopback IPs blocked, redirects
# re-validated, raster images only, no SVG) and caches the bytes on disk.
MEDIA_PROXY_ENABLED=true
# Max bytes fetched per proxied image.
MEDIA_PROXY_MAX_BYTES=20971520
# Cache TTL for proxied images (hours).
MEDIA_PROXY_TTL_HOURS=24

# -------------------------------------------
# Security
# -------------------------------------------
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=7d
TRUST_PROXY=1

# Auth lock policy: block (reject all) | trusted_ip (registered + last-login IPs
# may sign in without unlocking) | email (unlock requires an email link)
AUTH_LOCK_POLICY=trusted_ip
# Lock duration in minutes after the free attempts run out; -1 = permanent lock
AUTH_LOCK_DURATION_MINUTES=-1
# TTL in minutes for the email unlock link
AUTH_UNLOCK_TOKEN_TTL_MINUTES=30
# TTL in hours for the email verification link sent after registration
# (accounts whose email is unverified cannot sign in until it is confirmed)
EMAIL_VERIFY_TOKEN_TTL_HOURS=72
# Auth log retention in days and how often the cleanup job runs (minutes)
AUTH_LOG_RETENTION_DAYS=30
AUTH_LOG_CLEANUP_INTERVAL_MINUTES=60

# -------------------------------------------
# Email (SMTP)
# -------------------------------------------
SMTP_ENABLED=false

# Automatically email accounts that still have to accept when the Terms of Service
# or Privacy Policy versions change. Runs once at boot and never re-sends the same
# version pair. The FIRST run only records a baseline and sends nothing, so
# upgrading an existing instance never mails every user about a change that did
# not happen - bump POLICY_VERSIONS afterwards to trigger a real send.
# The Admin -> Legal button works even when this is false.
POLICY_NOTICE_AUTO_EMAIL=true

# The consent gate blocks every authenticated API call until an account accepts the
# current Terms of Service / Privacy Policy. That includes the ADMIN account, which
# means bumping the policy versions locks the operator out of the panel they
# administer. These two settings record acceptance automatically for operator
# accounts - but only after the SAME 30-day review window every other account gets,
# never on the spot, and always with a marker saying the platform recorded it rather
# than a person clicking accept.
#
# POLICY_ADMIN_AUTO_ACCEPT=false makes staff click through like anyone else.
# POLICY_ADMIN_AUTO_ACCEPT_ROLES takes comma-separated role slugs and defaults to the
# single built-in `admin` role. Widening it to a broad staff list is a deliberate
# decision for the instance operator, not a default.
POLICY_ADMIN_AUTO_ACCEPT=true
POLICY_ADMIN_AUTO_ACCEPT_ROLES=admin

SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BioPlatform
SMTP_FROM_EMAIL=

# Backend tests NEVER send real email by default (SMTP is forced off in
# tests/setup-env.ts). To exercise the actual send paths, opt in explicitly:
#   RUN_LIVE_EMAIL_TESTS=1
#   TEST_EMAIL_TO=you@example.com   (a REAL destination you control; test
#                                    addresses are derived from its domain)
# When unset/0, the suite runs fully offline and sends nothing.
#RUN_LIVE_EMAIL_TESTS=0
#TEST_EMAIL_TO=

# -------------------------------------------
# Newsletter
# -------------------------------------------
# Transport for per-profile newsletters: smtp (uses SMTP_* above) or resend.
NEWSLETTER_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=
# Shelf-life (days) of one-click unsubscribe links.
NEWSLETTER_UNSUBSCRIBE_TTL_DAYS=365
# Physical postal address required by CAN-SPAM/CASL, shown in every newsletter
# footer. When empty, the site URL is used as the required fallback.
NEWSLETTER_MAILING_ADDRESS=
# Per-send recipient cap for profiles that send with their own SMTP deliverer
# (anti-spam). The instance-wide admin cap stays fixed at 5000 recipients.
NEWSLETTER_SELF_RECIPIENT_CAP=1000
# Instance-owner opt-in that lets non-admin users send via the instance's own
# SMTP. Off by default: when enabled, the account must ALSO be allowlisted per
# user in Admin → Newsletter → Sender allowlist, is limited by the per-tier send
# window and capped by NEWSLETTER_PLATFORM_RECIPIENT_CAP.
NEWSLETTER_PLATFORM_SMTP_ENABLED=false
NEWSLETTER_PLATFORM_RECIPIENT_CAP=100

# -------------------------------------------
# Product shop
# -------------------------------------------
# Max size of a single product file (deliverable) in MB.
PRODUCT_FILE_MAX_MB=50
# Shelf-life (hours) of signed product download links.
PRODUCT_DOWNLOAD_TTL_HOURS=168
# Shelf-life (days) of guest purchase client tokens (status polling).
PRODUCT_PURCHASE_TOKEN_TTL_DAYS=30

# -------------------------------------------
# Admin (used by seed script — set a unique, strong password!)
# -------------------------------------------
ADMIN_EMAIL=admin@localhost.localhost
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-strong-admin-password

# Set to "true" on first run to seed the admin user and invite codes.
# Remove after the first successful start — the seed is idempotent but
# the entrypoint no longer runs it automatically.
SEED_ON_START=false

# -------------------------------------------
# Schema migration on start
# -------------------------------------------
# The entrypoint applies pending Prisma migrations BEFORE the server starts, so a
# fresh volume reaches a healthy state with no manual `prisma` command. It waits
# for the database (retries below) and exits non-zero instead of starting a server
# whose schema does not match.
MIGRATE_ON_START=true
# 30 attempts x 2 seconds = wait up to ~60s for PostgreSQL to accept connections.
DB_WAIT_ATTEMPTS=30
DB_WAIT_INTERVAL=2

# -------------------------------------------
# WebAuthn (passkeys)
# -------------------------------------------
# RP ID = the registrable domain (no port). Origin(s) must match the EXACT scheme+host+port
# the browser uses to reach the app. Comma-separate multiple origins (e.g. http://localhost:80,https://localhost).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:80
WEBAUTHN_RP_NAME=BioPlatform
# Days a passkey's residency verification stays "fresh" after a discoverable login
# (sliding: each discoverable login resets the window). NULL/older => admin "not secure" flag.
PASSKEY_RESIDENCY_TTL_DAYS=14
# Admin panel: flag users who have no passkey registered at all as "not secure".
ADMIN_FLAG_USERS_WITHOUT_PASSKEYS=true

# -------------------------------------------
# Discord integration (optional — leave empty to disable)
# Create an app at https://discord.com/developers/applications
# OAuth2 redirect must be the same as DISCORD_REDIRECT_URI
# Scopes used: identify (account link + webhook embeds)
# -------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:80/api/discord/callback
# Optional — enables live presence. Create a BOT user in the same app,
# enable the privileged "Presence Intent" (Settings → Bot → Privileged
# Gateway Intents), invite it to a server, and require users to be in that
# server for their status to be shown.
DISCORD_BOT_TOKEN=
# Optional — Discord server invite shown as a "Join presence hub" button in
# the Dashboard Discord tab so users know where to join the bot.
DISCORD_GUILD_INVITE=

# -------------------------------------------
# ACME (automatic TLS certificates for custom domains)
# -------------------------------------------
# Enables automatic Let's Encrypt issuance/renewal for ACTIVE custom domains
# (HTTP-01 challenge). Requires each custom domain to point to this server
# (DNS A/AAAA) and port 80 to be reachable from the internet.
ACME_ENABLED=false
# Defaults to the Let's Encrypt production directory. Use
# https://acme-staging-v02.api.letsencrypt.org/directory for testing.
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Contact email used when registering the ACME account.
ACME_EMAIL=
# Renew when a certificate expires within this many days.
ACME_RENEW_BEFORE_DAYS=30
# How often the backend checks for certificates that need issuing/renewing.
ACME_INTERVAL_MINUTES=60
# Maximum number of domains issued per run (Let's Encrypt rate-limit safety).
ACME_MAX_DOMAINS_PER_RUN=20
# Directory where certificates + the generated nginx conf are written.
# In Docker this is the same host folder mounted into nginx at /etc/nginx/certs.
ACME_CERTS_PATH=certs

# When true, custom domains are available to all tiers (including FREE),
# subject only to the profiles.customDomain role permission. Default false
# preserves the PRO/ENTERPRISE-only behavior.
CUSTOM_DOMAINS_ALL_TIERS=false

# -------------------------------------------
# Affiliate / referral program
# -------------------------------------------
# Flat discount (%) every invited user receives for being referred. 0 disables.
AFFILIATE_INVITEE_DISCOUNT_PERCENT=10
# How many days the referral discount stays valid. -1 = never expires.
AFFILIATE_DISCOUNT_DURATION_DAYS=365
# Referrer discount milestones: "count:percent" comma list, e.g. "2:10,5:20".
# When a referrer's redeemed invites reach a level, their discount grows to the
# highest reached percent. Empty = referrer discounts disabled.
AFFILIATE_DISCOUNT_LEVELS=
# Referrer invite-credit milestones: "count:credits" comma list, e.g. "3:1,6:2".
# Each newly reached level grants that many extra invite credits.
AFFILIATE_ALLOWANCE_LEVELS=
# Referrer badge milestones: "count:badgeSlug" comma list, e.g. "5:top-referrer".
# Badges must exist (see badges.manage). Reached levels grant the badge.
AFFILIATE_BADGE_LEVELS=
# Anti-abuse action when the same IP/device already claimed an invite or a
# referral: "reject" blocks the registration, "skip" creates the account but
# grants no referral/discount, "warn" does the same and returns a warning.
AFFILIATE_ABUSE_ACTION=reject
# Where anti-abuse applies: "referrals", "invites", or "both".
AFFILIATE_ABUSE_SCOPE=both

# -------------------------------------------
# Billing / orders
# -------------------------------------------
# Billing mode. Currently "one-time" is active; "subscription" and
# "fixed-term" are planned. This is a placeholder for the checkout layer.
BILLING_MODE=one-time
# Plan base prices in minor units (cents) and the ISO-4217 currency.
BILLING_PRICE_PRO_CENTS=500
BILLING_PRICE_ENTERPRISE_CENTS=2900
BILLING_CURRENCY=USD

# -------------------------------------------
# Paid invite credits
# -------------------------------------------
# Packs a buyer may purchase, as `quantity:priceInMinorUnits` pairs separated by
# commas. The prices are in BILLING_CURRENCY's minor unit, exactly like
# BILLING_PRICE_*_CENTS above. Quantities are DISCRETE: only the quantities listed
# here can be bought, which is what keeps a volume discount honest — an arbitrary
# quantity is never quietly priced at the cheapest per-credit rate.
#
#   INVITE_PRICE_PACKS=1:100,3:200,10:600   ->  1 credit for 1.00, 3 for 2.00, 10 for 6.00
#
# Invalid entries are skipped rather than fatal, so one typo only removes that
# pack. Leaving this EMPTY means the paid-invite store cannot sell anything, even
# if purchasing is enabled in Admin -> Invites: an empty list is the hard off
# switch.
INVITE_PRICE_PACKS=
# How long a guest's emailed invite codes stay valid. Member credits never expire
# (they sit on the account balance); only codes mailed to a buyer who has no
# account yet need a bounded lifetime.
INVITE_PURCHASE_CODE_TTL_DAYS=30

# -------------------------------------------
# Stripe checkout. STRIPE_ENABLED=true activates card payments via Checkout
# Sessions; webhooks must point at POST /api/payments/webhooks/stripe.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# -------------------------------------------
# PayPal checkouts (Orders v2 + webhooks). PAYPAL_MODE=sandbox for testing.
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# -------------------------------------------
# Crypto payments. Providers are pluggable; "btcpayserver" (self-hosted,
# works with OpenNode/CoinGate/others behind the BTCPay-style API) and
# "bitpay". Transaction amounts are quoted in fiat and converted to coin
# using CRYPTO_RATE_SOURCE (CoinGecko) with CRYPTO_RATE_FALLBACK as the
# offline price (format "BTC=95000,LTC=85,XMR=180"). Webhook route:
# POST /api/payments/webhooks/<provider> (crypto → btcpayserver|bitpay).
CRYPTO_ENABLED=false
CRYPTO_PROVIDERS=btcpayserver
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BITPAY_API_KEY=
BITPAY_WEBHOOK_SECRET=
CRYPTO_COINS=BTC,LTC,XMR
CRYPTO_RATE_SOURCE=coingecko
CRYPTO_RATE_FALLBACK=
CRYPTO_RATE_CACHE_SECONDS=300

# -------------------------------------------
# SSO (Single Sign-On): optional "sign in with Google / GitHub / Discord".
# Leave all values empty to disable SSO. Fill in at least one provider's
# client id + secret to enable it. For each OAuth app, register the
# callback URL: <SSO_CALLBACK_URL or APP_URL>/api/auth/oauth/callback.
# When SSO is enabled, SSO_SIGNUP_REQUIRES_INVITE gates new accounts made
# through SSO (as with email signup). SSO_2FA_BYPASS_ALLOWED lets users
# whose account opts in (Security tab) skip the 2FA step on SSO logins.
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
SSO_DISCORD_CLIENT_ID=
SSO_DISCORD_CLIENT_SECRET=
SSO_CALLBACK_URL=
SSO_SIGNUP_REQUIRES_INVITE=true
SSO_2FA_BYPASS_ALLOWED=false

# -------------------------------------------
# Captcha (human verification) on registration + login.
# Provider: none | turnstile | recaptcha | hcaptcha.
# With provider "none", the captcha widget is hidden and no challenge is shown.
# CAPTCHA_SITE_KEY is exposed publicly in the frontend (safe, it is not a secret).
# CAPTCHA_SECRET_KEY is server-side only and must never be exposed.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# -------------------------------------------
# External analytics: none | matomo (self-hosted, consent-gated).
# When enabled, the Matomo tracker (matomo.js/matomo.php) is loaded only after
# a visitor accepts non-essential cookies and is never loaded for visitors who
# send Do Not Track / Global Privacy Control. Both vars are safe to expose.
ANALYTICS_PROVIDER=none
ANALYTICS_MATOMO_URL=
ANALYTICS_MATOMO_SITE_ID=0

# -------------------------------------------
# PocketBase — OPTIONAL, and only ever a sign-in provider.
#
# BioPlatform never depends on PocketBase. Leave POCKETBASE_URL empty and the
# platform is complete on its own: accounts, links, shop, billing, newsletter
# and admin all live in PostgreSQL, and no code path requires PocketBase to be
# installed, reachable or healthy.
#
# POCKETBASE_URL   — server-facing PocketBase base URL. Leave empty to disable
#                    PocketBase entirely. The bundled docker-compose uses
#                    http://pocketbase:8090 (a PocketBase instance is added to
#                    the stack); for an external instance put its URL here.
# POCKETBASE_CLIENT_URL — browser-facing base the sign-in form posts to.
#                    Defaults to /api/pb-speed (nginx proxies it to PocketBase)
#                    so credentials are sent same-origin and never to us. For an
#                    external instance, use its full public URL.
# POCKETBASE_ADMIN_EMAIL / _PASSWORD — superuser used by the backend for
#                    internal reads. Never exposed to clients.
# POCKETBASE_AUTH_COLLECTION — auth collection holding end-user accounts (default users).
# POCKETBASE_OAUTH_ENABLED — show the PocketBase sign-in button and enable the
#                    /api/auth/oauth/pocketbase/* endpoints. Requires a URL.
#
# REMOVED — do not set these any more, they are ignored:
#   POCKETBASE_ANALYTICS_ENABLED — pageviews/link clicks are stored, aggregated
#                    and pruned (90 days) in PostgreSQL. The PocketBase copy was
#                    a second, never-read, never-pruned duplicate.
#   POCKETBASE_STORAGE_ENABLED, POCKETBASE_CONTENT_ENABLED,
#   POCKETBASE_MAX_UPLOAD_MB — declared and advertised through /api/features but
#                    never implemented. Use the built-in storage (B2/S3/local)
#                    for files.
#   POCKETBASE_BOOTSTRAP — existed only to auto-create the analytics collections.
#
# UPGRADING FROM A VERSION THAT RAN THE ANALYTICS MODULE: delete the
# `analytics_pageviews` and `analytics_linkclicks` collections in the PocketBase
# admin UI. They hold visitor identifiers, user agents and referrers that this
# platform never pruned and could not erase on request; nothing reads them since
# analytics moved to PostgreSQL.
POCKETBASE_URL=
POCKETBASE_CLIENT_URL=/api/pb-speed
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
POCKETBASE_AUTH_COLLECTION=users
POCKETBASE_OAUTH_ENABLED=false

# -------------------------------------------
# Link section / custom icon / QR features
# (instance-owner opt-in; default OFF)
# -------------------------------------------
LINKS_SECTIONS_ENABLED=false
LINKS_CUSTOM_ICONS_ENABLED=false
LINKS_QR_ENABLED=false

# -------------------------------------------
# Docker images (prebuilt)
# -------------------------------------------
# Default: Docker Hub (dracoservices/*). Override to use GHCR:
#   BACKEND_IMAGE=ghcr.io/00kino547/bioplatform-backend:latest
#   FRONTEND_IMAGE=ghcr.io/00kino547/bioplatform-frontend:latest
BACKEND_IMAGE=dracoservices/bioplatform-backend:latest
FRONTEND_IMAGE=dracoservices/bioplatform-frontend:latest
