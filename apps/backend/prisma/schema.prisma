generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  FREE
  PRO
  ENTERPRISE
}

enum CustomDomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  REJECTED
}

enum TlsStatus {
  NONE
  PENDING
  ISSUED
  FAILED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @db.Uuid @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  tier         UserTier  @default(FREE)
  trackLimit   Int?      @map("track_limit")
  profileLimit Int?      @map("profile_limit")
  aliasLimit   Int?      @map("alias_limit")
  badges       Badge[]
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  registeredIp String?   @map("registered_ip")
  lastLoginIp  String?   @map("last_login_ip")
  inviteAllowance      Int       @default(0) @map("invite_allowance")
  inviteAllowanceExpiresAt DateTime? @map("invite_allowance_expires_at")
  inviteLastGeneratedAt DateTime? @map("invite_last_generated_at")
  inviteBanned Boolean   @default(false) @map("invite_banned")
  inviteBannedAt DateTime? @map("invite_banned_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  inviteUsed   InviteCode? @relation("InviteUsedBy")
  inviteCreated InviteCode[] @relation("InviteCreatedBy")
  inviteGrants InviteGrantEvent[]
  profiles     Profile[]
  passkeys     Passkey[]
  webauthnChallenges WebAuthnChallenge[]
  webhooks     Webhook[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[] @default([])
  inviteBatchLimit      Int @default(0) @map("invite_batch_limit")
  inviteOutstandingLimit Int @default(0) @map("invite_outstanding_limit")
  inviteCooldownMinutes Int @default(0) @map("invite_cooldown_minutes")
  inviteDefaultExpiryDays Int @default(30) @map("invite_default_expiry_days")
  inviteMinExpiryDays   Int @default(1) @map("invite_min_expiry_days")
  inviteMaxExpiryDays   Int @default(365) @map("invite_max_expiry_days")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model Badge {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  label     String
  color     String   @default("#22c55e")
  icon      String   @default("Award")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  profiles Profile[]

  @@map("badges")
}

model Profile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid @map("user_id")
  slug          String   @unique
  isPrimary     Boolean  @default(false) @map("is_primary")
  badges        Badge[]
  badgeOrder    String[] @default([]) @map("badge_order")
  displayName   String?  @map("display_name")
  bio           String?
  avatar        String?
  banner        String?
  location      String?
  website       String?
  socialLinks         Json?    @map("social_links")
  theme               Json?
  notifyOnView        Boolean  @default(false) @map("notify_on_view")
  notifyOnClick       Boolean  @default(false) @map("notify_on_click")
  isPublic            Boolean  @default(true) @map("is_public")
  showDiscordPresence Boolean  @default(false) @map("show_discord_presence")
  showDiscordActivity Boolean  @default(true) @map("show_discord_activity")
  discordWebhookUrlEncrypted String? @map("discord_webhook_url_encrypted")
  discordPostedMessageId String? @map("discord_posted_message_id")
  discordPostedWebhookUrlEncrypted String? @map("discord_posted_webhook_url_encrypted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliases    ProfileAlias[]
  pageViews  PageView[]
  linkClicks LinkClick[]
  musicTracks MusicTrack[]
  discordConnection DiscordConnection?
  customDomain ProfileDomain?

  @@index([userId])
  @@map("profiles")
}

model ProfileAlias {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid @map("profile_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_aliases")
}

model ProfileDomain {
  id            String              @id @default(uuid()) @db.Uuid
  profileId     String              @unique @db.Uuid @map("profile_id")
  domain        String              @unique
  status        CustomDomainStatus  @default(PENDING_VERIFICATION) @map("status")
  verificationToken String         @map("verification_token")
  verifiedAt    DateTime?           @map("verified_at")
  approvedAt    DateTime?           @map("approved_at")
  rejectedAt    DateTime?           @map("rejected_at")
  rootTarget    String?             @map("root_target")
  tlsStatus     TlsStatus           @default(NONE) @map("tls_status")
  tlsIssuedAt   DateTime?           @map("tls_issued_at")
  tlsExpiresAt  DateTime?           @map("tls_expires_at")
  tlsError      String?             @map("tls_error")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_domains")
}

model DiscordConnection {
  id                  String   @id @default(uuid()) @db.Uuid
  profileId           String   @unique @db.Uuid @map("profile_id")
  discordId           String   @unique @map("discord_id")
  username            String
  globalName          String?  @map("global_name")
  avatar              String?
  accessTokenEncrypted String  @map("access_token_encrypted")
  refreshTokenEncrypted String @map("refresh_token_encrypted")
  tokenExpiresAt      DateTime @map("token_expires_at")
  connectedAt         DateTime @default(now()) @map("connected_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("discord_connections")
}

model PageView {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid @map("profile_id")
  ip        String?
  userAgent String?  @map("user_agent")
  visitorId String?  @map("visitor_id")
  referer   String?
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, visitorId])
  @@map("page_views")
}

model LinkClick {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid @map("profile_id")
  platform  String
  ip        String?
  userAgent String?  @map("user_agent")
  visitorId String?  @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, visitorId])
  @@map("link_clicks")
}

model MusicTrack {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid @map("profile_id")
  provider  String
  title     String?
  artist    String?
  url       String?
  filePath  String?  @map("file_path")
  fullUrl   String?  @map("full_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("music_tracks")
}

model InviteCode {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  createdById String  @db.Uuid @map("created_by_id")
  usedById  String?   @unique @db.Uuid @map("used_by_id")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  fromAllowance Boolean @default(false) @map("from_allowance")
  refundedAt DateTime? @map("refunded_at")
  createdAt DateTime  @default(now()) @map("created_at")

  createdBy User    @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy    User?   @relation("InviteUsedBy", fields: [usedById], references: [id])

  @@index([code])
  @@index([createdById])
  @@map("invite_codes")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model InviteGrantEvent {
  id          String   @id @default(uuid()) @db.Uuid
  count       Int
  expiryDays  Int      @map("expiry_days")
  createdById String?  @db.Uuid @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("invite_grant_events")
}

model Passkey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  transports   String[] @default([])
  name         String
  residentKey  Boolean  @default(false) @map("resident_key")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  challenge String
  purpose   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("web_authn_challenges")
}

model AuthBan {
  id         String    @id @default(uuid()) @db.Uuid
  kind       String
  value      String
  failCount  Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  permanent  Boolean   @default(false) @map("permanent")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([kind, value])
  @@index([kind])
  @@map("auth_bans")
}

model AuthLog {
  id            String    @id @default(uuid()) @db.Uuid
  kind          String
  username      String?
  accountId     String?   @db.Uuid @map("account_id")
  ip            String
  userAgentHash String?   @map("user_agent_hash")
  fingerprint   String?
  reason        String
  penaltyMinutes Int?     @map("penalty_minutes")
  permanent     Boolean   @default(false)
  triggeredBy   String?   @map("triggered_by")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([accountId])
  @@index([fingerprint])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("auth_logs")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  name      String
  url       String
  secretEncrypted String @map("secret_encrypted")
  secretPrefix String @map("secret_prefix")
  active    Boolean  @default(true)
  events    String[] @default([])
  template  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  webhookId      String   @db.Uuid @map("webhook_id")
  event          String
  payload        Json
  status         String   @default("pending")
  attempts       Int      @default(0)
  lastStatusCode Int?     @map("last_status_code")
  lastError      String?  @map("last_error")
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}
