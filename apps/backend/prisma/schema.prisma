generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserTier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(USER)
  tier         UserTier  @default(FREE)
  trackLimit   Int?      @map("track_limit")
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  inviteUsed   InviteCode? @relation("InviteUsedBy")
  inviteCreated InviteCode[] @relation("InviteCreatedBy")
  profile      Profile?
  passkeys     Passkey[]
  webauthnChallenges WebAuthnChallenge[]

  @@map("users")
}

model Profile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid @map("user_id")
  displayName   String?  @map("display_name")
  bio           String?
  avatar        String?
  banner        String?
  location      String?
  website       String?
  socialLinks         Json?    @map("social_links")
  theme               Json?
  notifyOnView        Boolean  @default(false) @map("notify_on_view")
  notifyOnClick       Boolean  @default(false) @map("notify_on_click")
  isPublic            Boolean  @default(true) @map("is_public")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageViews  PageView[]
  linkClicks LinkClick[]
  musicTracks MusicTrack[]

  @@map("profiles")
}

model PageView {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid @map("profile_id")
  ip        String?
  userAgent String?  @map("user_agent")
  visitorId String?  @map("visitor_id")
  referer   String?
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, visitorId])
  @@map("page_views")
}

model LinkClick {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid @map("profile_id")
  platform  String
  ip        String?
  userAgent String?  @map("user_agent")
  visitorId String?  @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, visitorId])
  @@map("link_clicks")
}

model MusicTrack {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid @map("profile_id")
  provider  String
  title     String?
  artist    String?
  url       String?
  filePath  String?  @map("file_path")
  fullUrl   String?  @map("full_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("music_tracks")
}

model InviteCode {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  createdById String  @db.Uuid @map("created_by_id")
  usedById  String?   @unique @db.Uuid @map("used_by_id")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  createdBy User    @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy    User?   @relation("InviteUsedBy", fields: [usedById], references: [id])

  @@index([code])
  @@map("invite_codes")
}

model Passkey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  transports   String[] @default([])
  name         String
  residentKey  Boolean  @default(false) @map("resident_key")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  challenge String
  purpose   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("web_authn_challenges")
}
